# ─── Base ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ifpc
REDIS_URL=redis://localhost:6379
AUTH_SECRET=cambiar-por-secreto-seguro

# ─── Base de datos embebida (PGlite / PostgreSQL WASM) ──
# Sin servidor externo: USE_PGLITE=true + `pnpm db:setup-pglite` la primera vez.
# Con Docker/Postgres real, pon USE_PGLITE=false.
USE_PGLITE=true
# Ruta ABSOLUTA al directorio de datos (debe ser el MISMO valor para los
# scripts de la raíz y para la app web, que corren con distinto CWD).
#   Linux/macOS: /home/tu-usuario/IFPC/.pglite
#   Windows:     C:/Users/tu-usuario/IFPC/.pglite
PGLITE_DIR=/ruta/absoluta/al/repo/.pglite

# ─── Storage (S3 / MinIO) ───────────────────────────────
# Driver de subidas: `local` (por defecto, disco) o `s3`.
STORAGE_DRIVER=local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=ifpc
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# `true` (por defecto) = endpoint/bucket (MinIO); `false` = bucket.endpoint (AWS).
S3_FORCE_PATH_STYLE=true
# Base de las URLs públicas si sirve un CDN por delante (opcional).
# S3_PUBLIC_BASE_URL=https://cdn.midominio.com

# Directorio local de uploads (fase actual) — ruta ABSOLUTA
#   Linux/macOS: /home/tu-usuario/IFPC/apps/web/public/uploads
#   Windows:     C:/Users/tu-usuario/IFPC/apps/web/public/uploads
UPLOAD_DIR=/ruta/absoluta/al/repo/apps/web/public/uploads

# ─── Pagos (Stripe) ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_cambiar
STRIPE_WEBHOOK_SECRET=whsec_cambiar

# ─── Email (Resend) ─────────────────────────────────────
RESEND_API_KEY=re_cambiar
