# ─── Base ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/future_buller
REDIS_URL=redis://localhost:6379
AUTH_SECRET=cambiar-por-secreto-seguro

# ─── Base de datos embebida (PGlite / PostgreSQL WASM) ──
# Sin servidor externo: USE_PGLITE=true + `pnpm db:setup-pglite` la primera vez.
# Con Docker/Postgres real, pon USE_PGLITE=false.
USE_PGLITE=true
PGLITE_DIR=C:/Users/ruis/Documents/proyect2/.pglite

# ─── Storage (S3 / MinIO) ───────────────────────────────
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=future-buller
S3_ENDPOINT=http://localhost:9000

# Directorio local de uploads (fase actual)
UPLOAD_DIR=C:/Users/ruis/Documents/proyect2/apps/web/public/uploads

# ─── Pagos (Stripe) ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_cambiar
STRIPE_WEBHOOK_SECRET=whsec_cambiar

# ─── Email (Resend) ─────────────────────────────────────
RESEND_API_KEY=re_cambiar
