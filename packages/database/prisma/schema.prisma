generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  PARENT
  COACH
  SCOUT
  AGENT
  CLUB
  UNIVERSITY
  SCHOOL
  ADMIN
}

enum SchoolType {
  SCHOOL
  COMMUNITY_SERVICE
}

enum PlayerStatus {
  PENDING_VERIFICATION
  ACTIVE
  AVAILABLE
  INACTIVE
}

enum OpportunityType {
  TRIAL
  SCOUTING
  CONTRACT
  SCHOLARSHIP
  ACADEMY
}

enum OpportunityStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MembershipTier {
  FREE
  PREMIUM
  SCOUT
  CLUB
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CampStatus {
  DRAFT
  OPEN
  FULL
  CANCELLED
  FINISHED
}

enum LiveSessionType {
  TRAINING
  LECTURE
  Q_AND_A
  TRIAL
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  role          Role      @default(PLAYER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  player        Player?
  parent        Parent?
  coach         Coach?
  scout         Scout?
  agent         Agent?
  club          Club?
  university    University?
  school        School?
  memberships   Membership[]
  payments      Payment[]
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  staffMemberships ClubStaff[]
  conversations     ConversationParticipant[]
  messagesSent      Message[]
  posts             Post[]
  postLikes         PostLike[]
  postComments      PostComment[]
  postReports       PostReport[]
  moderationLogs    ModerationLog[]
  following         Follow[] @relation("FollowFollower")
  followers         Follow[] @relation("FollowFollowing")
  privacyOwned      PrivacyRule[] @relation("PrivacyOwner")
  privacyReceived   PrivacyRule[] @relation("PrivacyTarget")
  pollVotes         PostPollVote[]
  notInterested     PostNotInterested[]

  @@index([role])
}

model Player {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  nationality  String?
  position     String?
  foot         String?
  heightCm     Int?
  weightKg     Int?
  status       PlayerStatus @default(PENDING_VERIFICATION)
  competitionLevel String?
  bio          String?
  clubName     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  videos        Video[]
  applications  Application[]
  savedOpportunities SavedOpportunity[]
  goals         PlayerGoal[]
  evaluations   Evaluation[]
  documents     Document[]
  pathway       Pathway?
  submissions   Submission[]
  trials        Trial[]
  negotiations  Negotiation[]
  contracts     Contract[]
  scoutingReports ScoutingReport[]
  savedBy       SavedPlayer[]
  agents        AgentPlayer[]
  coaches       CoachPlayer[]
  parents       ParentChild[]
  liveSessions  LiveSession[]
  campRegistrations CampRegistration[]
  career        CareerEntry[]
  profileViews  ProfileView[]

  @@index([status])
  @@index([position])
}

/// Trayectoria deportiva: club, categoría y estadísticas por temporada.
model CareerEntry {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  clubName    String
  category    String? // Sub-14, Sub-17, First team, School…
  season      String // 2024/25
  appearances Int      @default(0)
  goals       Int      @default(0)
  assists     Int      @default(0)
  isCurrent   Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([playerId, clubName, season])
  @@index([playerId, isCurrent])
}

/// Visitas de terceros al perfil de un jugador: un registro por visitante.
model ProfileView {
  id            String   @id @default(cuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  viewerUserId  String
  viewerRole    String // Role del visitante en el momento de la visita
  viewCount     Int      @default(1)
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())

  @@unique([playerId, viewerUserId])
  @@index([playerId, lastViewedAt])
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children ParentChild[]
}

model ParentChild {
  id        String   @id @default(cuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  since     DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([parentId, playerId])
  @@index([playerId])
}

model Coach {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players CoachPlayer[]
  camps   Camp[]
  liveSessions LiveSession[]
}

model CoachPlayer {
  id        String   @id @default(cuid())
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  since     DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([coachId, playerId])
  @@index([playerId])
}

model Scout {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scoutingReports ScoutingReport[]
  savedPlayers    SavedPlayer[]
}

model Agent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency    String?
  license   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players     AgentPlayer[]
  submissions Submission[]
}

model Club {
  id          String   @id @default(cuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String   @unique
  name        String
  country     String
  city        String?
  league      String?
  logoUrl     String?
  verified    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  opportunities Opportunity[]
  submissions   Submission[]
  trials        Trial[]
  negotiations  Negotiation[]
  contracts     Contract[]
  inquiries     Inquiry[]
  requirements  Requirement[]
  staff         ClubStaff[]
  camps         Camp[]

  @@index([country])
}

model Academy {
  id          String   @id @default(cuid())
  name        String
  clubId      String?
  country     String
  city        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model University {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  country   String
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
}

model School {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        SchoolType @default(SCHOOL)
  country     String
  city        String?
  contactName String?
  website     String?
  description String?
  verified    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([country])
}

model Opportunity {
  id          String            @id @default(cuid())
  clubId      String?
  club        Club?             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  universityId String?
  university  University?       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  creatorType String            @default("CLUB") // CLUB | UNIVERSITY
  title       String
  type        OpportunityType
  status      OpportunityStatus @default(OPEN)
  position    String?
  ageMin      Int?
  ageMax      Int?
  location    String?
  description String?
  closesAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  applications Application[]

  savedBy SavedOpportunity[]

  // Publicaciones de Discovery que comparten esta oportunidad.
  posts Post[]

  @@index([status, type])
}

model Application {
  id            String            @id @default(cuid())
  playerId      String
  player        Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(PENDING)
  message       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([playerId, opportunityId])
}

model SavedOpportunity {
  id            String       @id @default(cuid())
  playerId      String
  player        Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([playerId, opportunityId])
}

model Video {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  title        String
  url          String
  thumbnailUrl String?
  duration     Int?
  status       String   @default("uploading") // uploading | processing | ready | failed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([playerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String?
  link      String?
  /// Avisos agrupados (varias personas haciendo lo mismo sobre el mismo post).
  count     Int      @default(1)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, type, link, read])
}

model Membership {
  id                   String         @id @default(cuid())
  userId               String         @unique
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 MembershipTier @default(FREE)
  startsAt             DateTime       @default(now())
  endsAt               DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               PaymentStatus  @default(PENDING)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  description           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TrainingContent {
  id              String   @id @default(cuid())
  title           String
  category        String // technical | strength-conditioning | psychology | parent-education
  description     String?
  videoUrl        String?
  thumbnailUrl    String?
  durationMinutes Int?
  difficulty      Int? // 1-5
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
}

model Pathway {
  id          String    @id @default(cuid())
  playerId    String?   @unique
  player      Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  title       String
  description String?
  level       String?
  focus       String?
  goals       String?
  startsAt    DateTime?
  endsAt      DateTime?
  status      String    @default("active") // active | completed | paused
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PlayerGoal {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  status      String   @default("pending") // pending | in_progress | completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([playerId, status])
}

model Evaluation {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  category    String // technical | physical | tactical | psychological
  score       Int // 1-10
  notes       String?
  evaluatedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([playerId, category])
}

model Submission {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  stage     String   @default("SUBMISSION") // SUBMISSION | TRIAL | NEGOTIATION | CONTRACT
  status    String   @default("PENDING") // PENDING | IN_REVIEW | ACCEPTED | REJECTED | WITHDRAWN
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trial       Trial?
  negotiation Negotiation?
  contract    Contract?

  @@index([playerId])
  @@index([clubId])
  @@index([status])
}

model Trial {
  id           String      @id @default(cuid())
  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  clubId       String
  club         Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime?
  location     String?
  status       String      @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | NO_SHOW
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([clubId])
  @@index([playerId])
}

model Negotiation {
  id           String      @id @default(cuid())
  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  clubId       String
  club         Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status       String      @default("OPEN") // OPEN | ONGOING | ACCEPTED | REJECTED | CLOSED
  offerAmount  Int?
  currency     String      @default("EUR")
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  contract Contract?

  @@index([clubId])
}

model Contract {
  id            String      @id @default(cuid())
  negotiationId String?     @unique
  negotiation   Negotiation? @relation(fields: [negotiationId], references: [id], onDelete: SetNull)
  submissionId  String?     @unique
  submission    Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  clubId        String
  club          Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  endsAt        DateTime?
  salary        Int?
  currency      String      @default("EUR")
  status        String      @default("PENDING_SIGNATURE") // PENDING_SIGNATURE | SIGNED | ACTIVE | EXPIRED | TERMINATED
  signedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([clubId])
  @@index([playerId])
}

model Document {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  title     String
  url       String
  type      String   @default("other") // passport | contract | medical | other
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
}

model ScoutingReport {
  id         String   @id @default(cuid())
  scoutId    String
  scout      Scout    @relation(fields: [scoutId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rating     Int // 1-10
  strengths  String?
  weaknesses String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([scoutId])
  @@index([playerId])
}

model SavedPlayer {
  id        String   @id @default(cuid())
  scoutId   String
  scout     Scout    @relation(fields: [scoutId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([scoutId, playerId])
}

model Inquiry {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name        String
  email       String
  subject     String?
  message     String
  status      String    @default("NEW") // NEW | IN_PROGRESS | CLOSED
  response    String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clubId, status])
}

model Requirement {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  position    String?
  ageMin      Int?
  ageMax      Int?
  level       String?
  country     String?
  description String?
  status      String   @default("OPEN") // OPEN | FILLED | CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clubId, status])
}

model ClubStaff {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("STAFF") // OWNER | MANAGER | COACH | SCOUT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, userId])
}

model AgentPlayer {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  since     DateTime @default(now())
  status    String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt DateTime @default(now())

  @@unique([agentId, playerId])
}

model Camp {
  id          String     @id @default(cuid())
  title       String
  description String?
  country     String?
  city        String?
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int?
  price       Int? // in cents (29900 = €299.00)
  currency    String     @default("EUR")
  status      CampStatus @default(DRAFT)
  coverUrl    String?
  coachId     String?
  coach       Coach?     @relation(fields: [coachId], references: [id], onDelete: SetNull)
  clubId      String?
  club        Club?      @relation(fields: [clubId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  registrations CampRegistration[]

  @@index([status])
  @@index([startsAt])
}

model CampRegistration {
  id        String   @id @default(cuid())
  campId    String
  camp      Camp     @relation(fields: [campId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  createdAt DateTime @default(now())

  @@unique([playerId, campId])
  @@index([campId, status])
}

model LiveSession {
  id          String            @id @default(cuid())
  title       String
  description String?
  type        LiveSessionType   @default(TRAINING)
  status      LiveSessionStatus @default(SCHEDULED)
  startsAt    DateTime
  endsAt      DateTime?
  meetingUrl  String?
  coachId     String?
  coach       Coach?            @relation(fields: [coachId], references: [id], onDelete: SetNull)
  playerId    String?
  player      Player?           @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([startsAt])
}

model Conversation {
  id        String   @id @default(cuid())
  subject   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Discovery: feed interno compartido por todos los perfiles.
// Cuelga de `User` (no de `Player`) para que cualquier rol pueda publicar.
// ---------------------------------------------------------------------------

enum PostType {
  ANNOUNCEMENT
  VIDEO
  PHOTO
  ACHIEVEMENT
}

enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

/// Quién puede comentar una publicación.
enum CommentsPolicy {
  EVERYONE
  FOLLOWERS
  NOBODY
}

/// Publicación del feed. `authorId` es el usuario de cualquier rol.
model Post {
  id            String        @id @default(cuid())
  authorId      String
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type          PostType      @default(ANNOUNCEMENT)
  status        PostStatus    @default(PUBLISHED)
  title         String?
  body          String?
  mediaUrl      String? // /uploads/posts/... o URL externa
  mediaKind     String? // image | video | embed
  /// Miniatura del vídeo (fotograma extraído con ffmpeg), si se pudo generar.
  posterUrl     String?
  /// Galería de imágenes subidas (hasta 4); `mediaUrl` sigue siendo la principal.
  mediaUrls     String[]      @default([])
  /// Texto alternativo del medio (accesibilidad).
  mediaAlt      String?
  /// Publicación programada: se publica al llegar la fecha (script/cron).
  publishAt     DateTime?
  /// Opciones de encuesta (hasta 4); vacío cuando no hay encuesta.
  pollOptions   String[]      @default([])
  linkUrl       String?
  opportunityId String?
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  tags          String[]       @default([])
  /// Quién puede comentar esta publicación (el autor decide).
  commentsPolicy CommentsPolicy @default(EVERYONE)
  pinnedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  likes    PostLike[]
  comments PostComment[]
  views    PostView[]
  reports  PostReport[]
  pollVotes PostPollVote[]
  notInterested PostNotInterested[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
  @@index([type, createdAt])
}

/// Un "me gusta" por usuario y publicación.
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

/// Comentario (un nivel de respuestas).
model PostComment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")
  body      String
  createdAt DateTime      @default(now())

  @@index([postId, createdAt])
}

/// Vistas de un post: un registro por espectador (mismo patrón que `ProfileView`).
model PostView {
  id            String   @id @default(cuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewerUserId  String
  viewerRole    String // Role del espectador en el momento de la vista
  viewCount     Int      @default(1)
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())

  @@unique([postId, viewerUserId])
  @@index([postId, lastViewedAt])
}

/// Denuncia de una publicación (moderación).
model PostReport {
  id         String    @id @default(cuid())
  postId     String
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  /// Se rellena cuando un admin da la denuncia por atendida.
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([postId, reporterId])
  @@index([postId])
}

/// Traza de moderación: quién hizo qué sobre una publicación y cuándo.
/// `postId` no es una relación a propósito, para que el registro sobreviva al
/// borrado de la publicación.
model ModerationLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  postId    String
  /// HIDDEN | PUBLISHED | PINNED | UNPINNED | DELETED | RESOLVED
  action    String
  notes     String?
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([actorId, createdAt])
}

/// Relación social entre perfiles: quién sigue a quién (cualquier rol).
/// Habilita la pestaña "Siguiendo" del feed y los avisos de nuevo seguidor.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// Voto de una encuesta: uno por persona y publicación.
/// Un voto por usuario y publicación. Se puede cambiar de opción.
model PostPollVote {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

/// "No me interesa": el espectador deja de ver esa publicación en los listados.
/// (No es moderación ni privacidad: solo afecta a sus propios feeds y se puede
/// deshacer desde el detalle de la publicación.)
model PostNotInterested {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

/// Preferencias de privacidad entre perfiles: bloquear (no nos vemos ni
/// interactuamos) o silenciar (solo dejo de ver su contenido).
model PrivacyRule {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("PrivacyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("PrivacyTarget", fields: [targetId], references: [id], onDelete: Cascade)
  /// BLOCK | MUTE
  kind      String
  createdAt DateTime @default(now())

  @@unique([ownerId, targetId])
  @@index([targetId, kind])
}


