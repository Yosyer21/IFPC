# Web (Next.js standalone)
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./
COPY packages ./packages
COPY apps ./apps
COPY infrastructure ./infrastructure
RUN pnpm install --frozen-lockfile --filter @ifpc/web... --filter @ifpc/rtc... --filter @ifpc/database

FROM base AS builder
ENV STANDALONE=true
COPY --from=deps /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/tsconfig.json ./
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/infrastructure ./infrastructure
RUN pnpm --filter @ifpc/database db:generate && pnpm --filter @ifpc/web build
# Seed de demo empaquetado en un único ESM: el cliente Prisma y bcryptjs se
# incluyen en el bundle (igual que hace Next con la app, el output standalone no
# los deja como paquetes) y el adaptador PGlite se sustituye por un shim (no se
# usa en producción). El query engine se resuelve en runtime con
# PRISMA_QUERY_ENGINE_LIBRARY (ver la fase runner). El banner aporta `require`,
# `__dirname` y `__filename` (ESM) porque bcryptjs/Prisma los necesitan.
RUN ESBUILD="$(ls -d node_modules/.pnpm/esbuild@*/node_modules/esbuild/bin/esbuild 2>/dev/null | head -1)" ; \
    if [ -z "$ESBUILD" ]; then echo 'ERROR: esbuild no está disponible en el builder'; exit 1; fi ; \
    "$ESBUILD" --version ; \
    "$ESBUILD" packages/database/prisma/seed.ts \
      --bundle --platform=node --target=node22 --format=esm \
      --banner:js="import { createRequire as __createRequire } from 'node:module'; import { fileURLToPath as __fileURLToPath } from 'node:url'; import { dirname as __pathDirname } from 'node:path'; const require = __createRequire(import.meta.url); const __filename = __fileURLToPath(import.meta.url); const __dirname = __pathDirname(__filename);" \
      --outfile=/app/seed.mjs \
      --define:process.env.USE_PGLITE='"false"' \
      --alias:@electric-sql/pglite=./infrastructure/docker/pglite-shim.js \
      --alias:pglite-prisma-adapter=./infrastructure/docker/pglite-shim.js

# Servicio de salas de vídeo (rtc) empaquetado igual: sale de esta misma imagen y
# se arranca con SERVICE_KIND=rtc (ver start-web.sh), así los dos servicios del
# proyecto comparten Dockerfile sin necesidad de configurarlo por servicio.
RUN ESBUILD="$(ls -d node_modules/.pnpm/esbuild@*/node_modules/esbuild/bin/esbuild 2>/dev/null | head -1)" ; \
    if [ -z "$ESBUILD" ]; then echo 'ERROR: esbuild no está disponible en el builder'; exit 1; fi ; \
    "$ESBUILD" apps/rtc/src/index.ts \
      --bundle --platform=node --target=node22 --format=esm \
      --banner:js="import { createRequire as __createRequire } from 'node:module'; import { fileURLToPath as __fileURLToPath } from 'node:url'; import { dirname as __pathDirname } from 'node:path'; const require = __createRequire(import.meta.url); const __filename = __fileURLToPath(import.meta.url); const __dirname = __pathDirname(__filename);" \
      --outfile=/app/rtc.mjs \
      --alias:@electric-sql/pglite=./infrastructure/docker/pglite-shim.js \
      --alias:pglite-prisma-adapter=./infrastructure/docker/pglite-shim.js

FROM base AS runner
ENV NODE_ENV=production
# libc6-compat (Next standalone) + openssl (Prisma) para Alpine.
RUN apk add --no-cache libc6-compat openssl
RUN addgroup -S nodejs && adduser -S nextjs -G nodejs
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
# Prisma: el output standalone no traza el query engine (.so.node). Se copia al contenedor
# y se apunta con PRISMA_QUERY_ENGINE_LIBRARY.
RUN mkdir -p /app/prisma-engines
COPY --from=builder /app/node_modules/.pnpm/@prisma+client@*/node_modules/.prisma/client/libquery_engine-linux-musl-openssl-3.0.x.so.node /app/prisma-engines/
ENV PRISMA_QUERY_ENGINE_LIBRARY=/app/prisma-engines/libquery_engine-linux-musl-openssl-3.0.x.so.node
# Prisma CLI + schema: permiten aplicar el esquema (`prisma db push`) en el arranque,
# de modo que la base de datos se mantiene alineada con el código en cada deploy.
RUN npm i -g prisma@6.19.3
COPY --from=builder /app/packages/database/prisma ./packages/database/prisma
# Seed de demo (ESM) y script de arranque.
COPY --from=builder /app/seed.mjs ./seed.mjs
COPY --from=builder /app/rtc.mjs ./rtc.mjs
COPY --from=builder /app/infrastructure/docker/start-web.sh ./start-web.sh
USER nextjs
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["sh", "./start-web.sh"]
